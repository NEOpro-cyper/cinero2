# ══════════════════════════════════════════════════════════════════
#  P-Stream environment variables
#  ─────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in the values you need.
#  ALL of these are optional — the app will run without any of them,
#  though some features (TMDB metadata, in-browser streaming, account
#  sync) will be unavailable until you set them.
#
#  For runtime-only config (no rebuild needed), edit `public/config.js`
#  or `config.js` (root-level, for Docker volume mount).
# ══════════════════════════════════════════════════════════════════

# Your TMDB read API key. Get one at:
# https://www.themoviedb.org/settings/api
VITE_TMDB_READ_API_KEY=

# Whether to enable OpenSearch (search-engine discovery). Default: false.
VITE_OPENSEARCH_ENABLED=false


# Your Google Analytics Tracking Code or ID:
VITE_GA_ID=G-F2VEE04XTE

# ── CORS proxy ────────────────────────────────────────────────────
# Required for in-browser playback of cross-origin HLS/MP4 streams.
# The URL must NOT end with a slash (unless you're using a path-style
# proxy like `?url=`).
#
# Examples:
#   VITE_CORS_PROXY_URL=https://corsproxy.io/?url=
#   VITE_CORS_PROXY_URL=https://my-proxy.workers.dev/?url=
#   VITE_CORS_PROXY_URL=https://my-proxy.workers.dev
#
# You can also specify multiple proxies (comma-separated) and the
# player will load-balance across them:
#   VITE_CORS_PROXY_URL=https://proxy1.workers.dev,https://proxy2.workers.dev
VITE_CORS_PROXY_URL=

# ── M3U8 proxy ────────────────────────────────────────────────────
# Same rules as above. Used specifically for HLS m3u8 playlists.
# Can be a comma-separated list.
VITE_M3U8_PROXY_URL=

# ── App domain ────────────────────────────────────────────────────
# Used for OpenSearch, PWA manifest, and Trakt redirect URI.
# Make sure the URL does NOT end with a slash.
VITE_APP_DOMAIN=https://cinero.vercel.app

# ── Backend URL(s) ────────────────────────────────────────────────
# Optional. Used for the accounts / sync feature. Can be a single
# URL or a comma-separated list (the player will pick one at random).
VITE_BACKEND_URL=

# ── Routing ───────────────────────────────────────────────────────
# Use History API routing (true) or hash-based routing (false).
# For nginx / Vercel / Netlify, leave as true.
VITE_NORMAL_ROUTER=true

# ── Onboarding ────────────────────────────────────────────────────
# Show the onboarding flow on first visit (default: false).
VITE_HAS_ONBOARDING=false

# Links shown in the onboarding flow (optional).
VITE_ONBOARDING_CHROME_EXTENSION_INSTALL_LINK=
VITE_ONBOARDING_FIREFOX_EXTENSION_INSTALL_LINK=
VITE_ONBOARDING_PROXY_INSTALL_LINK=

# ── DMCA / legal ──────────────────────────────────────────────────
# Email shown in the footer for DMCA claims. Leave empty to hide.
VITE_DMCA_EMAIL=

# Comma-separated list of disallowed IDs (DMCA takedowns).
# Format: "movie-<id>" or "series-<id>".
VITE_DISALLOWED_IDS=

# CDN host replacements, comma-separated, "old:new" pairs.
VITE_CDN_REPLACEMENTS=

# ── Player features ───────────────────────────────────────────────
VITE_ALLOW_AUTOPLAY=false
VITE_ALLOW_FEBBOX_KEY=false
VITE_ALLOW_DEBRID_KEY=false

# ── PWA ───────────────────────────────────────────────────────────
# Enable PWA / service worker. Default: false.
VITE_PWA_ENABLED=false

# ── Ads / banners / tracking (all optional) ───────────────────────
VITE_SHOW_AD=false
VITE_AD_CONTENT_URL=
VITE_TRACK_SCRIPT=
VITE_BANNER_MESSAGE=
VITE_BANNER_ID=
VITE_HIDE_PROXY_ONBOARDING=false
VITE_SHOW_SUPPORT_BAR=false
VITE_SUPPORT_BAR_VALUE=

# ── Trakt integration ─────────────────────────────────────────────
# Get these at https://trakt.tv/oauth/applications
VITE_USE_TRAKT=false
VITE_TRAKT_CLIENT_ID=
VITE_TRAKT_CLIENT_SECRET=
VITE_TRAKT_REDIRECT_URI=

# ── AniList rotating proxy (server-side, bypasses rate limits) ────
# AniList enforces ~30 req/min per IP. The standalone server.js
# tunnels all AniList GraphQL requests through this rotating HTTP
# proxy (HTTP CONNECT) so each request appears to come from a
# different IP, bypassing the rate limit entirely.
#
# Format: http://user:pass@host:port
# Leave empty to disable (requests go direct — subject to rate limit).
#
# Get one at https://www.webshare.io/ (rotating residential proxies)
ANILIST_PROXY_URL=http://dkmxrsew-rotate:hd1zl1cegrxs@p.webshare.io:80
